# Copy this file to production.env on the host and set the real secret values.
KEYCLOAK_DB_NAME=change-me
KEYCLOAK_DB_USER=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=change-me
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=change-me
KEYCLOAK_ISSUER=https://auth.kassel.smartspeechflow.de/realms/ssf
KEYCLOAK_AUDIENCE=ssf-frontend
KEYCLOAK_REQUIRED_ROLE=ssf-user
# Temporary migration switch. The access code is intentionally not a secret.
SSF_ENABLE_LEGACY_ADMIN_ACCESS=false
SSF_LEGACY_ADMIN_ACCESS_CODE=change-me
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# Internal analytics database. Required: the production Compose file fails to
# interpolate without these.
CLICKHOUSE_DB=ssf_analytics
CLICKHOUSE_USER=ssf_telemetry
CLICKHOUSE_PASSWORD=replace_with_a_unique_strong_password

# Quality telemetry (OTLP -> otel-collector -> ClickHouse).
# One of `disabled`, `probe` or `enabled`; any other value logs a warning and
# falls back to `disabled` without affecting gateway startup.
#   disabled  no exporter is built at all. The production default.
#   probe     transport check only, reachable from the admin probe endpoint.
#             Emits no pipeline events, so turning it on adds no event volume.
#   enabled   additionally emits real pipeline events: session_lifecycle,
#             translation_message and refinement_attempt.
# Leave this `disabled` until the production enablement steps in
# docs/operations/runbooks/clickhouse-operations.md have been completed --
# the schema must be applied before the collector starts exporting, and
# migrations 002, 003 and 004 must all be applied before `enabled`, or events
# land with only their envelope columns populated. Rows written in that
# window cannot be repaired -- the attributes never reached ClickHouse.
SSF_QUALITY_TELEMETRY_MODE=disabled
# Keys the HMAC that turns a session id into the `session_ref` stored in
# ClickHouse. Session ids are 32-bit, so an unkeyed digest of one can be
# reversed by enumerating the id space; the key is what makes the reference
# one-way. Unset, the gateway generates one per process and warns: telemetry
# rows from different processes or restarts then no longer group by session.
# Any high-entropy string; `openssl rand -hex 32` is a fine source.
SSF_QUALITY_TELEMETRY_SESSION_KEY=
SSF_OTLP_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
# Set to the deployed git sha, matching the prod-<sha> image tags.
SSF_RELEASE_VERSION=unknown
SSF_DEPLOYMENT_ENV=production
