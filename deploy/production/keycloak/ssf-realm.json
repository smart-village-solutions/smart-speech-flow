{
  "realm": "ssf",
  "enabled": true,
  "displayName": "Smart Speech Flow",
  "loginTheme": "kasseldialog",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "ssf-user",
        "description": "Administrative access to Smart Speech Flow"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ssf-frontend",
      "name": "Smart Speech Flow Frontend",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://dialog.kassel.de/login/*"
      ],
      "webOrigins": [
        "https://dialog.kassel.de"
      ],
      "protocolMappers": [
        {
          "name": "ssf-frontend audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "ssf-frontend",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "studio-ssf-authorization-revision",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ssf_authorization_revision",
            "claim.name": "ssf_authorization_revision",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ]
}
