          "editorType": "sql",
          "format": 0,
          "refId": "A",
          "rawSql": "SELECT toStartOfInterval(emitted_at_utc, INTERVAL 1 HOUR) AS time, lifecycle_phase, count() AS sessions FROM quality_events FINAL WHERE event_type = 'session_lifecycle' AND $__timeFilter(emitted_at_utc) GROUP BY time, lifecycle_phase ORDER BY time"
