# Smart Speech Flow - Environment Variables
# ==========================================

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_NAMESPACE=ssf

# Client Configuration
CLIENT_BASE_URL=https://translate.smart-village.solutions

# Audio Storage Configuration
# ----------------------------
# Path where audio files are stored (original input + translated output)
AUDIO_STORAGE_PATH=/data/audio

# How long to keep audio files before automatic deletion (in hours)
# Default: 24 hours (for privacy compliance)
AUDIO_RETENTION_HOURS=24

# Temporary storage path for uploads (before processing)
# Use tmpfs mount for better performance
AUDIO_TEMP_PATH=/tmp/audio

# Maximum disk usage for audio storage (in GB)
# Alerts trigger at 80% and 95% of this limit
AUDIO_MAX_DISK_USAGE_GB=9

# Audio cleanup job interval (in minutes)
# Default: 60 (runs hourly)
AUDIO_CLEANUP_INTERVAL_MINUTES=60

# Enable pipeline metadata in WebSocket messages
# Always true for prototype phase
ENABLE_PIPELINE_METADATA=true

# Internal ClickHouse analytics service
CLICKHOUSE_DB=ssf_analytics
CLICKHOUSE_USER=ssf_telemetry
CLICKHOUSE_PASSWORD=replace_with_a_unique_strong_password

# Quality telemetry (OTLP -> collector -> ClickHouse)
# SSF_QUALITY_TELEMETRY_MODE is one of `disabled`, `probe` or `enabled`. Any
# other value logs a warning and falls back to `disabled`; it never stops the
# gateway.
#   disabled  no exporter is built at all.
#   probe     transport check only, via the admin probe endpoint. No pipeline
#             events, so turning it on adds no event volume.
#   enabled   additionally emits real pipeline events: session_lifecycle,
#             translation_message and refinement_attempt.
# `probe` for local and dev, so the pipeline produces rows without extra setup.
# Production overrides this to `disabled` in deploy/production/.
SSF_QUALITY_TELEMETRY_MODE=probe
# Keys the HMAC that turns a session id into the `session_ref` stored in
# ClickHouse. Session ids are 32-bit, so an unkeyed digest of one can be
# reversed by enumerating the id space; the key is what makes the reference
# one-way. Unset, the gateway generates one per process and warns: telemetry
# rows from different processes or restarts then no longer group by session.
# Any high-entropy string; `openssl rand -hex 32` is a fine source.
SSF_QUALITY_TELEMETRY_SESSION_KEY=
SSF_OTLP_LOGS_ENDPOINT=http://otel-collector:4318/v1/logs
SSF_RELEASE_VERSION=unknown
# Set per environment. Left as `unknown` deliberately: this file gets copied
# onto real hosts, and a wrong value silently mislabels every event.
SSF_DEPLOYMENT_ENV=unknown

# Keycloak identity provider and private PostgreSQL database
KEYCLOAK_HOSTNAME=auth.example.com
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace_with_a_unique_strong_database_password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=keycloak_admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_strong_admin_password

# LLM Refinement Configuration
# -----------------------------
# Enable/disable LLM-based translation refinement
LLM_REFINEMENT_ENABLED=true

# LLM model to use for refinement (Ollama format)
LLM_REFINEMENT_MODEL=gpt-oss:20b
LLM_REFINEMENT_MODE=primary_only
LLM_REFINEMENT_PRIMARY_MODEL=gpt-oss:20b
LLM_REFINEMENT_CANDIDATE_MODEL=phi4-mini
LLM_REFINEMENT_SHADOW_QUEUE_LIMIT=4

# Ollama endpoint URL
LLM_REFINEMENT_ENDPOINT=http://ollama:11434

# Timeout for LLM requests (in seconds)
LLM_REFINEMENT_TIMEOUT=4.0

# LLM sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_REFINEMENT_TEMPERATURE=0.7

# Disable model reasoning; refinement only needs the final translated sentence
LLM_REFINEMENT_THINK=false

# Maximum retries for failed LLM requests
LLM_REFINEMENT_MAX_RETRIES=1

# Pipeline Admission Control
# ---------------------------
# Bounds how many translation pipelines run at once. One GPU hosts asr,
# translation and tts together, and each holds a single shared model, so the
# default is deliberately low. Raise it from load-test evidence, watching
# gateway_pipeline_in_flight, _queue_wait_seconds and _rejected_total on
# /metrics. Exactly 0 disables the bound; a negative value is rejected and the
# default is used instead.
MAX_CONCURRENT_PIPELINES=2

# How long a request waits for a free pipeline slot before it is rejected with
# 503 SYSTEM_BUSY and a Retry-After header (in seconds).
#
# Must exceed the p95 pipeline duration, and the default has not been measured
# against real traffic yet. A slot is held for the whole round trip through ASR,
# translation and TTS, so if a pipeline typically takes longer than this wait,
# every request that arrives at saturation burns the full wait and is then
# rejected — where before the bound existed it would have completed slowly.
# Raise it from the gateway_pipeline_queue_wait_seconds histogram once there is
# load-test data. Exactly 0 opts out of queueing and sheds immediately; a
# negative value is treated as a typo and the default is used.
PIPELINE_QUEUE_WAIT_SECONDS=10.0

# Translation Inference Admission Control — the same bound one layer down, on
# the translation service itself. Inference runs on a worker thread so /health
# and /metrics stay responsive during a beam search; this caps how many beam
# searches reach the shared M2M100 instance at once. Watch translation_in_flight,
# translation_queue_wait_seconds and translation_rejected_total on the service's
# /metrics. Exactly 0 disables the bound; a negative value is rejected and the
# default is used instead. Keep this at or above MAX_CONCURRENT_PIPELINES so the
# gateway stays the system-level capacity boundary.
MAX_CONCURRENT_TRANSLATIONS=2

# How long a translation request waits for a free inference slot before it is
# rejected with 503 and a Retry-After header (in seconds). Deliberately below
# the gateway's 30s HTTP timeout for /translate, so saturation surfaces as an
# attributable error rather than a caller-side timeout. Must likewise exceed the
# p95 inference duration. Exactly 0 opts out of queueing and sheds immediately;
# a negative value is treated as a typo and the default is used.
#
# An unparseable value in either translation setting is logged and ignored
# rather than raised: both are read at import, before uvicorn binds, so a typo
# would otherwise crash-loop the container instead of degrading to the default.
TRANSLATION_QUEUE_WAIT_SECONDS=25.0

# Rate Limiting Configuration
# ----------------------------
# Global rate limit (requests per window across all users)
GLOBAL_RATE_LIMIT=1200

# Global rate limit window (in seconds)
GLOBAL_RATE_WINDOW_SECONDS=60

# Per-session message rate limit
MESSAGE_RATE_LIMIT=50

# Per-session message rate limit window (in seconds)
MESSAGE_RATE_WINDOW_SECONDS=10

# Environment Configuration
# --------------------------
# Environment: 'production' or 'development'
ENVIRONMENT=production

# CORS origins for development (comma-separated)
# Only used when ENVIRONMENT=development
DEVELOPMENT_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Monitoring & Security Configuration
# ------------------------------------
# Grafana Admin Credentials (CHANGE THESE IN PRODUCTION!)
# Generate strong password: openssl rand -base64 32
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_use_strong_password_here

# Frontend Demo Password (CHANGE IN PRODUCTION!)
# This password protects the frontend demo landing page
FRONTEND_DEMO_PASSWORD=changeme_frontend_password
